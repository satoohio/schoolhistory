# Environment variables for School History project

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/schoolhistory

# Server
PORT=3001

# JWT Secret - GENERATE A STRONG RANDOM STRING FOR PRODUCTION!
# Example: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Cloudinary (optional, for production file storage)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
